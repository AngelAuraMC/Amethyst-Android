<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#18232A" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#25343B" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#244A4A" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/novacraft_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/novacraft_surface" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/novacraft_border" />
        </shape>
    </item>
</selector>
