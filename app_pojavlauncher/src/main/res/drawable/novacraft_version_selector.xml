<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#203640" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/novacraft_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/novacraft_surface_elevated" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/novacraft_border" />
        </shape>
    </item>
</selector>
