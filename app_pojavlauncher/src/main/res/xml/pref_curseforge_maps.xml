<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <net.kdt.pojavlaunch.prefs.BackButtonPreference/>

    <Preference
        android:key="curseforge_maps_profile"
        android:title="@string/novacraft_curseforge_maps_profile"
        android:summary="@string/novacraft_curseforge_maps_current_version"
        android:selectable="false"
        android:persistent="false" />

    <Preference
        android:key="curseforge_maps_api_key"
        android:title="@string/novacraft_curseforge_key_setup_title"
