    <Preference
        android:key="curseforge_maps_search"
        android:title="@string/novacraft_curseforge_maps_search"
        android:summary="@string/novacraft_curseforge_maps_search_summary" />

    <PreferenceCategory
        android:key="curseforge_maps_results"
