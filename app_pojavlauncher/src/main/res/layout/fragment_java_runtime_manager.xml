<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:clipToPadding="false"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/fragment_padding_medium"
        android:paddingTop="@dimen/padding_large"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/novacraft_runtime_manager_title"
            android:textColor="@color/primary_text"
            android:textSize="23sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/novacraft_runtime_manager_subtitle"
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/runtime_manager_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/primary_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/runtime_manager_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/runtime_manager_architecture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/runtime_manager_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textColor="@color/novacraft_accent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:id="@+id/runtime_manager_requirement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/runtime_manager_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="11dp"
            android:background="@drawable/background_overlay"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/runtime_manager_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/runtime_manager_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/novacraft_accent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:id="@+id/runtime_manager_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/runtime_manager_manage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/novacraft_runtime_manage" />

            <Button
                android:id="@+id/runtime_manager_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/novacraft_runtime_refresh" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/novacraft_runtime_installed_header"
            android:textColor="@color/novacraft_text_muted"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:id="@+id/runtime_manager_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/runtime_manager_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/background_overlay"
            android:text="@string/novacraft_runtime_empty"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/runtime_manager_downloads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/novacraft_accent"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/background_overlay"
            android:text="@string/novacraft_runtime_help"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
