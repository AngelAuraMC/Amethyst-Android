<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/novacraft_bottom_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/novacraft_account_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primary_text"
        android:textSize="17sp"
        android:fontFamily="sans-serif-bold" />

    <TextView
        android:id="@+id/novacraft_account_item_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/secondary_text"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kdt.mcgui.MineButton
            android:id="@+id/novacraft_account_select_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/novacraft_account_use" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/novacraft_account_remove_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/novacraft_account_remove" />

    </LinearLayout>
</LinearLayout>
