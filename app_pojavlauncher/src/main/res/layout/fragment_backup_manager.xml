<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:clipToPadding="false"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/fragment_padding_medium"
        android:paddingTop="@dimen/padding_large"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/novacraft_backup_title"
            android:textColor="@color/primary_text"
            android:textSize="23sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/novacraft_backup_subtitle"
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/backup_manager_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:textColor="@color/primary_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/backup_manager_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textColor="@color/secondary_text"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/novacraft_backup_select"
            android:textColor="@color/novacraft_text_muted"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.12" />

        <CheckBox
            android:id="@+id/backup_include_worlds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/novacraft_backup_worlds"
            android:textColor="@color/primary_text" />

        <CheckBox
            android:id="@+id/backup_include_mods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/novacraft_backup_mods"
            android:textColor="@color/primary_text" />

        <CheckBox
            android:id="@+id/backup_include_resourcepacks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/novacraft_backup_resourcepacks"
            android:textColor="@color/primary_text" />

        <CheckBox
            android:id="@+id/backup_include_shaderpacks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/novacraft_backup_shaderpacks"
            android:textColor="@color/primary_text" />

        <CheckBox
            android:id="@+id/backup_include_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/novacraft_backup_settings"
            android:textColor="@color/primary_text" />

        <CheckBox
            android:id="@+id/backup_include_skins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/novacraft_backup_skins"
            android:textColor="@color/primary_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:padding="11dp"
            android:background="@drawable/background_overlay"
            android:text="@string/novacraft_backup_sensitive_note"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backup_manager_create"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/novacraft_backup_create" />

            <Button
                android:id="@+id/backup_manager_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/novacraft_backup_import" />
        </LinearLayout>

        <TextView
            android:id="@+id/backup_manager_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/novacraft_accent"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/novacraft_backup_history"
                android:textColor="@color/novacraft_text_muted"
                android:textSize="10sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.12" />

            <Button
                android:id="@+id/backup_manager_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/novacraft_backup_refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/backup_manager_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:padding="13dp"
            android:background="@drawable/background_overlay"
            android:text="@string/novacraft_backup_empty"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/backup_manager_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
