<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/background_overlay"
    android:orientation="vertical"
    android:padding="13dp">

    <TextView
        android:id="@+id/pack_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primary_text"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold" />

    <TextView
        android:id="@+id/pack_item_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:textColor="@color/secondary_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/pack_item_format"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/secondary_text"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/pack_item_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/novacraft_accent"
        android:textSize="10sp"
        android:fontFamily="sans-serif-bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pack_item_toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/novacraft_pack_hide" />

        <Button
            android:id="@+id/pack_item_remove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:text="@string/global_remove" />
    </LinearLayout>
</LinearLayout>
